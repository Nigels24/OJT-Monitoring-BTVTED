# Base URL of the NestJS API. Optional in local dev — lib/api/baseQuery.ts
# falls back to http://localhost:3000 when this is unset.
#
# Note the server's CORS allowlist in app/server/src/main.ts only permits
# http://localhost:3001, so run the client with `npm run dev -- -p 3001`.
NEXT_PUBLIC_API_URL=http://localhost:3000
