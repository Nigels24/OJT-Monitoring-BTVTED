# ---------------------------------------------------------------------------
# OJT-Track website (app/client) — settings
#
# Copy this file to ".env" in the same folder. For the school deployment the
# defaults below are already right and nothing needs changing.
# ---------------------------------------------------------------------------

# Where THIS computer reaches the API (the app/server program). The website
# passes every /api request on to it, so browsers on other devices never need
# to know this address. It is read each time the website starts — no rebuild.
# Leave as is when both programs run on the same computer.
API_INTERNAL_URL=http://127.0.0.1:3000

# Leave this blank.
# Only for a development setup where the browser should call the API directly
# instead of through /api. It is fixed into the pages at build time, so a
# changed address would need a rebuild — exactly what the school deployment
# avoids. If set, the same address must be listed in the server's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=
