# ---------------------------------------------------------------------------
# OJT-Track API (app/server) — settings
#
# Copy this file to ".env" in the same folder and fill it in.
# Lines starting with # are notes. Do not put spaces around the = sign.
# docs/DEPLOYMENT.md walks through every step.
#
# REQUIRED: DATABASE_URL and JWT_SECRET. Everything else has a working default.
# ---------------------------------------------------------------------------

# --- Database (required) ----------------------------------------------------
# The PostgreSQL database on this computer:
#   postgresql://USER:PASSWORD@localhost:5432/DATABASE
# If the password has special characters (@ : / # ?), they must be
# percent-encoded, e.g. @ becomes %40. Letters and digits avoid the problem.
DATABASE_URL=postgresql://ojt_track:CHANGE_ME@localhost:5432/ojt_track

# Leave blank for a database on this computer — it then means "the same as
# DATABASE_URL". Only a hosted database behind a connection pooler (Supabase)
# needs a second, direct address here for running migrations.
DIRECT_URL=

# --- Sign-in secret (required) ----------------------------------------------
# A long random text that signs every login. The server will not start
# without it. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later signs everyone out.
JWT_SECRET=

# --- Network -----------------------------------------------------------------
# The port the API listens on, and the address it binds to. Other devices do
# NOT connect to this port — they use the website (port 3001), which passes
# requests on. Keep port 3000 closed in the firewall.
PORT=3000
HOST=0.0.0.0

# Websites allowed to call the API directly from a browser, comma-separated.
# Not needed for the school deployment (the website calls the API itself).
CORS_ORIGINS=http://localhost:3001

# --- Uploaded files ----------------------------------------------------------
# local    = keep files in a folder on this computer (the default)
# supabase = keep files in the Supabase bucket (needs the SUPABASE_ keys below)
STORAGE_DRIVER=local

# The folder for uploaded files when STORAGE_DRIVER=local. Blank means the
# "storage" folder inside app/server. It is created automatically.
# Example for another drive:  STORAGE_DIR=D:\ojt-track\storage
STORAGE_DIR=

# A second long random text, used to sign the temporary links to uploaded
# files (each link works for one hour). Make it the same way as JWT_SECRET.
# If left blank the server uses JWT_SECRET and prints a reminder at startup.
FILE_URL_SECRET=

# What a file link starts with. Leave blank (it means /api, which is right
# whenever the website is used in the normal way).
FILE_URL_BASE=

# Only for STORAGE_DRIVER=supabase, or to copy old files down once with
# "npm run storage:pull". Leave blank otherwise.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- First coordinator account (used once, by "npm run seed") ----------------
# The seed creates this account if it does not exist yet and prints a
# temporary password ONCE in the window where you ran it. The coordinator is
# asked to choose a new password at first sign-in.
SEED_COORDINATOR_EMAIL=coordinator@wphi.edu
SEED_COORDINATOR_NAME=Admin Coordinator
SEED_COORDINATOR_USERNAME=coordinator
# Leave blank. (Setting it gives that account a fixed password with no forced
# change — for a developer's throwaway database only.)
SEED_COORDINATOR_PASSWORD=

# The second coordinator (the other block). Always gets a generated password.
SEED_COORDINATOR2_EMAIL=coordinator2@wphi.edu
SEED_COORDINATOR2_NAME=Block B Coordinator
SEED_COORDINATOR2_USERNAME=coordinator2

# --- Login emails (optional) -------------------------------------------------
# New accounts and "Resend login" email the temporary password to the user from
# the institution's dedicated Gmail account. Leave MAIL_ENABLED=false (or these
# blank) and nothing is sent: the temporary password is shown to the coordinator
# once instead. The server starts either way. Sending needs internet access.

# true to send email, anything else (or blank) to keep it off.
MAIL_ENABLED=false

# The dedicated Gmail address the emails are sent from.
GMAIL_USER=

# A Gmail *app password* for that account (16 characters) — NOT its normal
# password. Needs 2-Step Verification turned on; create one at
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# The sender name recipients see. Blank uses the default shown here.
MAIL_FROM_NAME="OJT-Track — West Prime Horizon Institute"

# The address users type into their browser to open the system — the email
# tells them to go here. It is the WEBSITE's address on the school network:
# this computer's IP address and port 3001, for example
#   APP_PUBLIC_URL=http://192.168.1.10:3001
# If this computer's IP address ever changes, change it here and restart the
# API (no rebuild needed).
APP_PUBLIC_URL=

# --- Backups -----------------------------------------------------------------
# The folder "npm run backup" writes into — normally a folder on the external
# drive, e.g.  BACKUP_DIR=E:\ojt-backups   (macOS: /Volumes/Backup/ojt-backups)
# Required for backup and restore; the server itself does not use it.
BACKUP_DIR=

# The "bin" folder of PostgreSQL, where pg_dump and pg_restore live. Needed on
# Windows, where they are not found automatically, e.g.
#   PG_BIN_DIR=C:\Program Files\PostgreSQL\17\bin
# Leave blank on macOS/Linux if "pg_dump --version" works in a terminal.
PG_BIN_DIR=
