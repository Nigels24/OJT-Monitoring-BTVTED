// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  SUPERVISOR
  COORDINATOR
}

enum StudentStatus {
  ACTIVE
  PENDING
  COMPLETED
  INACTIVE
}

enum AttendanceStatus {
  PENDING
  APPROVED
  DECLINED
}

enum EstablishmentStatus {
  ACTIVE
  INACTIVE
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  CANCELLED
}

enum JournalStatus {
  SUBMITTED
  ACCEPTED
  RETURNED
}

/// ASSIGNED -> DONE (the student marks it, and may undo it) -> RATED (the
/// supervisor rates it, which is final for the student).
enum WeeklyTaskStatus {
  ASSIGNED
  DONE
  RATED
}

enum ConcernCategory {
  CONDUCT
  PERFORMANCE
  ATTENDANCE
  OTHER
}

enum ConcernStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// Who an announcement is for. Narrowed further by its optional block/course.
enum AnnouncementAudience {
  STUDENTS
  SUPERVISORS
  ALL
}

/// Which phase of the placement a required document belongs to (thesis Table 3).
enum DocumentStage {
  APPLICATION
  ACCEPTANCE
  COMPLETION
}

enum NotificationType {
  ATTENDANCE_APPROVED
  ATTENDANCE_DECLINED
  ATTENDANCE_OVERDUE
  JOURNAL_RETURNED
  JOURNAL_ACCEPTED
  DOCUMENT_REVIEWED
  ASSESSMENT_COMPLETED
  CONCERN_RAISED
  PLACEMENT_RECORDED
  WEEKLY_TASK_ASSIGNED
  WEEKLY_TASK_DONE
  WEEKLY_TASK_RATED
  CONCERN_RESPONDED
  ANNOUNCEMENT_POSTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  // Login name issued by the coordinator. Nullable because accounts created
  // before this existed have none — those still sign in with their email.
  // Logging in accepts either, so a username may never contain "@", which is
  // what keeps the two namespaces from colliding.
  username  String?  @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())

  // Forces a password change on next login. Defaults true so every account
  // the coordinator issues from now on is born in that state; the migration
  // that added this column backfills every user that already existed to
  // false, so nobody already signed in gets locked into a forced change.
  mustChangePassword Boolean @default(true)

  /// The outcome of the last attempt to email this account its login
  /// (CLAUDE.md §16) — never the password itself, which is stored only as the
  /// bcrypt hash above. Rewritten after every attempt, on creation and on
  /// "Resend login".
  ///
  /// `credentialsEmailStatus` is SENT | FAILED | NOT_CONFIGURED, a plain String
  /// like Document.status. `credentialsSentAt` is set only by a SENT attempt
  /// and cleared by any other, so it always means "the current temporary
  /// password was emailed then". `credentialsEmailError` is a short reason for
  /// the coordinator, with no secrets in it. All three NULL on an account that
  /// predates this, or one no attempt was ever made for.
  credentialsSentAt      DateTime?
  credentialsEmailStatus String?
  credentialsEmailError  String?

  studentProfile     Student?
  supervisorProfile  Supervisor?
  coordinatorProfile Coordinator?

  conversations     ConversationParticipant[]
  messagesSent      Message[]
  notifications     Notification[]
  announcementReads AnnouncementRead[]

  /// Documents this account uploaded — the student's own, or a coordinator's
  /// upload on a student's behalf. Keyed to User, not Student/Coordinator,
  /// because either role can be the uploader.
  uploadedDocuments Document[]
}

model Establishment {
  id                       String              @id @default(cuid())
  name                     String
  industryType             String?
  streetAddress            String?
  region                   String?
  barangay                 String?
  city                     String?
  province                 String?
  zipCode                  String?
  /// How many trainees the establishment can take at once. NULL = not set
  /// (no limit is shown). Compared against its ACTIVE training assignments to
  /// show "X of Y slots used"; a full establishment warns, it does not block
  /// (CLAUDE.md §19).
  traineeSlots             Int?
  status                   EstablishmentStatus @default(ACTIVE)
  coordinatorFirstName     String?
  coordinatorLastName      String?
  coordinatorMiddleInitial String?
  coordinatorAge           Int?
  coordinatorGender        String?
  coordinatorPosition      String?
  coordinatorAddress       String?
  coordinatorContact       String?
  coordinatorEmail         String?
  createdAt                DateTime            @default(now())

  supervisors Supervisor[]
  students    Student[]

  trainingAssignments TrainingAssignment[]
}

model Supervisor {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id])
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  position        String?

  attendanceApprovals Attendance[] @relation("ApprovedBy")
  evaluations         Evaluation[]
  weeklyTasks         WeeklyTask[]
  concernsRaised      Concern[]
}

model Coordinator {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  reviewedDocuments Document[]
  blocks            Block[]
  gradedAssignments TrainingAssignment[]
  reviewedJournals  JournalEntry[]
  concernsResponded Concern[]
  announcements     Announcement[]
}

/// A degree program that places students in OJT, e.g. "BTVTED-CHS".
/// Required hours are NOT stored here — they vary by year level, so they
/// live on CourseRequirement. `code` is the short identifier coordinators
/// pick from when creating a block or assignment.
model Course {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements  CourseRequirement[]
  blocks        Block[]
  students      Student[]
  announcements Announcement[]
}

/// How many OJT hours a course requires at a given year level. A program can
/// require OJT at more than one year level (e.g. a 3rd-year practicum and a
/// 4th-year internship), hence the (courseId, yearLevel) pair rather than a
/// single requiredHours column on Course.
model CourseRequirement {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  yearLevel     Int
  requiredHours Int
  createdAt     DateTime @default(now())

  trainingAssignments TrainingAssignment[]

  @@unique([courseId, yearLevel])
}

/// One cohort of students in a course/year level for one academic year, e.g.
/// "Block A" of BTVTED-CHS 4th year, 2025-2026. `coordinatorId` is the
/// coordinator who owns/advises the block and is nullable because a block can
/// exist before one is assigned.
model Block {
  id            String       @id @default(cuid())
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id])
  yearLevel     Int
  name          String
  coordinatorId String?
  coordinator   Coordinator? @relation(fields: [coordinatorId], references: [id])
  academicYear  String
  createdAt     DateTime     @default(now())

  students            Student[]
  trainingAssignments TrainingAssignment[]
  announcements       Announcement[]

  @@unique([courseId, yearLevel, name, academicYear])
}

/// One deployment of a student to an establishment. Attendance, Documents and
/// Evaluations attach here (via a nullable trainingAssignmentId, so existing
/// rows survive the migration unattributed until backfilled), not directly to
/// Student, because a student can be reassigned: reassignment ends this row
/// (status TRANSFERRED) and creates a new one starting at zero hours, rather
/// than mutating establishmentId/startDate in place and losing the history of
/// the first placement.
///
/// `requiredHours` is copied from CourseRequirement at creation, not read
/// live through `courseRequirementId` — a later change to the program's
/// requirement must not retroactively change what an in-progress or
/// already-completed assignment owes.
model TrainingAssignment {
  id                  String             @id @default(cuid())
  studentId           String
  student             Student            @relation(fields: [studentId], references: [id])
  establishmentId     String
  establishment       Establishment      @relation(fields: [establishmentId], references: [id])
  courseRequirementId String?
  courseRequirement   CourseRequirement? @relation(fields: [courseRequirementId], references: [id])
  blockId             String?
  block               Block?             @relation(fields: [blockId], references: [id])
  yearLevel           Int
  requiredHours       Int
  dutyDays            Weekday[]
  startDate           DateTime
  endDate             DateTime?
  academicYear        String
  status              AssignmentStatus   @default(ACTIVE)

  // The coordinator's own final grade for the whole placement (0-100), based
  // on the OJT portfolio report and its presentation. Separate from the
  // supervisor's per-sheet Evaluation.totalRating — not a rubric score.
  // Recorded once the assignment has ended or its approved hours reach
  // requiredHours, and correctable afterwards; gradedById/gradedAt are stamped
  // server-side and describe the grade as it stands (CLAUDE.md §13).
  coordinatorGrade        Decimal?     @db.Decimal(5, 2)
  coordinatorGradeRemarks String?
  gradedById              String?
  gradedBy                Coordinator? @relation(fields: [gradedById], references: [id])
  gradedAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances    Attendance[]
  documents      Document[]
  evaluations    Evaluation[]
  journalEntries JournalEntry[]
  weeklyTasks    WeeklyTask[]
  concerns       Concern[]
  /// The placement's group thread (CLAUDE.md §15). At most one.
  conversation   Conversation?

  @@index([studentId, status])
}

/// One dated journal entry: what the trainee did on one duty day, with
/// photographs attached (thesis "Journal Entries and Portfolio Support").
///
/// Attached to the TrainingAssignment, not the Student in general — a compiled
/// journal is *per placement*, ordered by date, so a student who transfers
/// starts a fresh journal rather than interleaving two establishments' days in
/// one document. `studentId` is kept alongside it (denormalised from the
/// assignment) purely so the student's own list and the `[studentId, status]`
/// index do not have to join through the assignment on every read.
///
/// Unlike Attendance, `trainingAssignmentId` is NOT nullable: no journal
/// predates this table, so there are no unattributed rows to keep, and every
/// scoping rule (coordinator's block, supervisor's establishment) can rely on
/// the assignment always being there.
model JournalEntry {
  id                   String             @id @default(cuid())
  trainingAssignmentId String
  trainingAssignment   TrainingAssignment @relation(fields: [trainingAssignmentId], references: [id])
  studentId            String
  student              Student            @relation(fields: [studentId], references: [id])

  /// The duty day being written up, stored as UTC midnight of that calendar
  /// day like every other date-only column (see src/common/dates.ts).
  entryDate DateTime @db.Date

  activities String
  learnings  String?

  status             JournalStatus @default(SUBMITTED)
  /// The coordinator's written comments. Required by the service on RETURN, and
  /// deliberately left in place when the student resubmits, so they can still
  /// see what they were asked to fix until it is reviewed again.
  coordinatorRemarks String?
  reviewedById       String?
  reviewedBy         Coordinator?  @relation(fields: [reviewedById], references: [id])
  reviewedAt         DateTime?

  /// Reset when a RETURNED entry is edited and resubmitted, the same way
  /// Attendance.submittedAt is — it is what the review notification's
  /// dedupeKey uses as its version marker, so a re-review after a
  /// resubmission notifies again instead of being collapsed.
  submittedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos JournalPhoto[]

  /// One entry per duty day per placement. Without this the compiled journal
  /// could print the same date twice with different contents.
  @@unique([trainingAssignmentId, entryDate])
  @@index([studentId, status])
}

/// A photograph attached to a journal entry.
///
/// `onDelete: Cascade` is the second narrow exception to CLAUDE.md §6, for the
/// same reason `Notification` is: a photo row has no independent meaning or
/// business consequence once its entry is gone. The *storage object* is not
/// covered by it — storage is not transactional, so every delete path still
/// collects `storagePath` and removes the file after the commit.
model JournalPhoto {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  /// Bucket key inside the private `student-files` bucket (`journals/...`).
  /// Never a public URL — reads go through a short-lived signed URL.
  storagePath  String
  /// The system-applied name (`StudentNo_JOURNAL_<date>_<n>_SURNAME.jpg`), not
  /// whatever the phone called the file — see src/common/file-upload.ts.
  originalName String
  /// Derived from the file's magic bytes, never from the request headers.
  mimeType     String
  sizeBytes    Int
  caption      String?
  sortOrder    Int
  createdAt    DateTime @default(now())
}

/// One task a supervisor assigns a trainee for one week, which the trainee
/// marks done (with optional proof photos) and the supervisor then rates 1-5.
/// Printed per week as the means of verification (MOV) for the daily journal.
///
/// Attached to the TrainingAssignment like JournalEntry, and for the same
/// reason: a week's tasks belong to a placement, so a student who transfers
/// starts a fresh list at the new establishment. `studentId` is denormalised
/// from the assignment purely for the student's own list.
///
/// The rating here is its own figure. It is never read by the supervisor's
/// Evaluation (totalRating) or the coordinator's grade (CLAUDE.md §14).
model WeeklyTask {
  id                   String             @id @default(cuid())
  trainingAssignmentId String
  trainingAssignment   TrainingAssignment @relation(fields: [trainingAssignmentId], references: [id])
  studentId            String
  student              Student            @relation(fields: [studentId], references: [id])

  /// Who assigned it. Nullable so the task — the trainee's own record, with
  /// their proof and rating on it — survives that supervisor's account being
  /// deleted, the same call as Attendance.approvedById (see cascade-delete.ts).
  supervisorId String?
  supervisor   Supervisor? @relation(fields: [supervisorId], references: [id])

  /// The Monday of the week the task belongs to, as UTC midnight like every
  /// other date-only column. Always normalised by `weekStartOf`
  /// (src/common/weekly-tasks.ts), whatever day of that week was sent.
  weekStart DateTime @db.Date

  title       String
  description String?
  dueDate     DateTime @db.Date

  status      WeeklyTaskStatus @default(ASSIGNED)
  /// Set when the student marks the task done, cleared if they undo it. Also
  /// the version marker of the "done" notification's dedupeKey.
  doneAt      DateTime?
  studentNote String?

  /// 1-5, set by the supervisor on a DONE task. Correctable afterwards;
  /// `ratedAt` moves only when the rating or its comment actually changes, so
  /// it doubles as the "rated" notification's version marker.
  rating        Int?
  ratingComment String?
  ratedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos WeeklyTaskPhoto[]

  @@index([trainingAssignmentId, weekStart])
  @@index([studentId, weekStart])
}

/// A proof photo the student attaches when marking a task done.
///
/// Same columns as JournalPhoto, but deliberately WITHOUT its
/// `onDelete: Cascade`: CLAUDE.md §6 allows that exception twice and this is
/// not a third. Every path that removes a task deletes its photo rows
/// explicitly first, and removes the storage objects after the commit.
model WeeklyTaskPhoto {
  id           String     @id @default(cuid())
  weeklyTaskId String
  weeklyTask   WeeklyTask @relation(fields: [weeklyTaskId], references: [id])

  /// Bucket key inside the private `student-files` bucket (`weekly-tasks/...`).
  /// Never a public URL — reads go through a short-lived signed URL.
  storagePath  String
  /// The system-applied name (`StudentNo_TASK_<date>_<n>_SURNAME.jpg`), not
  /// whatever the phone called the file — see src/common/file-upload.ts.
  originalName String
  /// Derived from the file's magic bytes, never from the request headers.
  mimeType     String
  sizeBytes    Int
  sortOrder    Int
  uploadedAt   DateTime @default(now())

  @@index([weeklyTaskId])
}

model Student {
  id              String @id @default(cuid())
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id])
  studentIdNumber String @unique

  // DEPRECATED - read from active TrainingAssignment. Kept, and still
  // written by the existing student-management flow, until the
  // controllers/services in the next step are moved onto TrainingAssignment.
  course          String?
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  requiredHours   Int            @default(0)
  startDate       DateTime?
  endDate         DateTime?
  yearLevel       String?
  status          StudentStatus  @default(ACTIVE)

  // Named `enrolledCourse`, not `course`, because the deprecated free-text
  // `course` field above already owns that name.
  courseId       String?
  enrolledCourse Course? @relation(fields: [courseId], references: [id])
  blockId        String?
  block          Block?  @relation(fields: [blockId], references: [id])

  // The structured counterpart to the deprecated `yearLevel` free-text column
  // above, matched against `CourseRequirement.yearLevel`. Nullable because a
  // student may have no course/year level set yet, and because every row
  // predating this column has none. `resolveCourseFields`
  // (coordinator.service.ts) keeps this and the legacy `yearLevel` string in
  // sync whenever either is written.
  courseYearLevel Int?

  // Personal details — only what OJT monitoring needs (CLAUDE.md §18). All
  // nullable because students created before each column existed have none.
  //
  // There is no `age` column: age is derived from `dateOfBirth` at read time
  // (src/common/age.ts) and returned with the student, never stored or typed.
  // There is no `school` column either: every student belongs to the one
  // school this system serves (src/common/school.ts).
  firstName     String?
  lastName      String?
  /// The full middle name. Where an initial is wanted ("Mundo, Juan D.") it is
  /// derived by src/common/person-name.ts. Replaced `middleInitial`; the
  /// migration carried the old initials over as-is.
  middleName    String?
  dateOfBirth   DateTime?
  contactNumber String?
  /// "Sex" in the UI — Male or Female. The column keeps its older name.
  gender        String?

  // Standardized address, chosen from the PSGC lists — the same shape
  // Establishment uses. Stored as *names*, not codes, like Establishment's;
  // the server checks they are consistent with each other
  // (src/common/ph-address.ts). `postalCode` is filled in automatically from
  // the city/municipality where a code is known.
  region           String?
  province         String?
  cityMunicipality String?
  barangay         String?
  /// House number / street / purok — the one free-text part. Optional.
  streetAddress    String?
  postalCode       String?
  /// DEPRECATED, read-only. The single free-text line the address used to be
  /// (the old `address` column, renamed). Shown for records that have no
  /// structured address yet; nothing writes it any more.
  legacyAddress    String?

  attendances         Attendance[]
  documents           Document[]
  credentials         Credential[]
  evaluations         Evaluation[]
  trainingAssignments TrainingAssignment[]
  journalEntries      JournalEntry[]
  weeklyTasks         WeeklyTask[]
  concerns            Concern[]
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  date      DateTime
  timeInAM  DateTime?
  timeOutAM DateTime?
  timeInPM  DateTime?
  timeOutPM DateTime?
  remarks   String?
  status    AttendanceStatus @default(PENDING)

  // Why a supervisor declined. Kept separate from `remarks`, which belongs to
  // the student — the prototype overwrote the student's note with the decline
  // reason, losing what they had written.
  declineReason String?

  approvedById String?
  approvedBy   Supervisor? @relation("ApprovedBy", fields: [approvedById], references: [id])

  // Nullable: rows written before this migration have no assignment to point
  // at and stay NULL until the backfill (or forever, for a student who never
  // had an establishment). See TrainingAssignment's doc comment.
  trainingAssignmentId String?
  trainingAssignment   TrainingAssignment? @relation(fields: [trainingAssignmentId], references: [id])

  createdAt DateTime @default(now())

  // Distinct from `createdAt`: a DECLINED row corrected and resubmitted is
  // updated in place (see StudentService.submitAttendance), which leaves
  // `createdAt` at the *original* insert time. The 21-day overdue window has
  // to measure from the most recent time this row *became* PENDING, or a
  // corrected resubmission would read as already overdue from the moment it
  // was saved. `createdAt` is right for "when was this row first written";
  // `submittedAt` is right for "how long has this specific PENDING state been
  // waiting on a supervisor" — see common/attendance-overdue.ts.
  submittedAt DateTime @default(now())

  // One log per student per day. Without this a student can submit the same
  // day repeatedly and every hours total counts it more than once.
  // `date` is normalised to UTC midnight on write (see StudentService), which
  // is what makes the constraint meaningful.
  @@unique([studentId, date])
  @@index([trainingAssignmentId])
}

/// One of the school's required documents (thesis Table 3), as data rather than a
/// hardcoded list — the same call the evaluation sheet makes (CLAUDE.md §9), so a
/// coordinator can retire or re-order a requirement without a migration.
///
/// `code` is the short identifier the system-applied filename carries
/// (`2022-00145_MOA_MUNDO.pdf`), so it must stay filename-safe and is the key
/// every seed and backfill matches on. Retiring a requirement is
/// `isActive: false`, never a delete: documents already uploaded against it keep
/// pointing at it.
model DocumentRequirement {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  stage     DocumentStage
  /// Display order within the stage; the stage itself orders by the enum.
  sortOrder Int
  isActive  Boolean       @default(true)

  /// True = one per training assignment (an endorsement letter, MOA and waiver
  /// belong to a *placement*, and a transferred student needs new ones). False =
  /// one per student for good (an application letter and resume are the
  /// student's own, written before they are placed anywhere).
  perAssignment Boolean

  documents Document[]
}

model Document {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  /// The system-applied filename (`StudentNo_CODE_SURNAME.ext`) for anything
  /// uploaded against a requirement — identifiable without opening it, and what
  /// a download saves as. Legacy rows (`requirementId` null) still hold the
  /// free text the student typed before Table 3 existed.
  name      String
  fileUrl   String
  status    String  @default("PENDING")

  /// Which Table 3 requirement this satisfies. Nullable for rows uploaded before
  /// the checklist existed and for anything the backfill could not map — those
  /// surface as "Other uploads" rather than being deleted or guessed at.
  requirementId String?
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id])

  /// Who actually uploaded the file: the student themselves, or the coordinator
  /// uploading on their behalf (the school produces the MOA and endorsement
  /// letter). Nullable for rows predating this column. Distinct from
  /// `reviewedById` — the uploader is not necessarily the reviewer, though for a
  /// coordinator upload (auto-approved) they are the same person.
  uploadedByUserId String?
  uploadedBy       User?   @relation(fields: [uploadedByUserId], references: [id])

  // Who actioned this review, their note, and when. `reviewNote` is required
  // by the service when status is REJECTED, mirroring
  // Attendance.declineReason; unlike Attendance.approvedById, this column is
  // named for what it actually means — the reviewer, not just "who approved".
  reviewedById String?
  reviewedBy   Coordinator? @relation(fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?

  trainingAssignmentId String?
  trainingAssignment   TrainingAssignment? @relation(fields: [trainingAssignmentId], references: [id])

  /// Refreshed when a PENDING/DECLINED upload is replaced in place, so the review
  /// queue re-sorts it as new work and the review notification's dedupeKey (which
  /// uses this value) treats it as a fresh cycle.
  uploadedAt DateTime @default(now())

  @@index([trainingAssignmentId])
  /// Serves both the "has this student satisfied this requirement" lookup on
  /// upload and the coordinator's status matrix.
  @@index([studentId, requirementId])
}

model Credential {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  type      String
  fileUrl   String
  createdAt DateTime @default(now())
}

model Evaluation {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  supervisorId String
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id])

  // The sheet this evaluation was written on, and the scores it was given.
  //
  // The form used to be nineteen fixed Int columns here; it is now a versioned
  // template the coordinator owns (EvaluationTemplate). A signed sheet keeps
  // its own `templateId` forever, so the wording, the item set and the maximum
  // it was signed with can never be rewritten by a later version. Editing an
  // old evaluation validates and renders against THAT version.
  //
  // `onDelete: Restrict` is the one referential action in this schema. It is a
  // restriction, not a cascade: the repo's policy is that deletes are spelled
  // out in src/common/cascade-delete.ts, and this says the opposite — a
  // template with evaluations on it must never be deleted at all.
  templateId String
  template   EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  scores     EvaluationScore[]

  // No uniqueness constraint on (studentId, supervisorId): a student is
  // deliberately evaluated more than once.

  // The form's TOTAL RATING: the raw sum of this sheet's items. Computed and
  // stored server-side, never accepted from the client. Deliberately raw — the
  // form has no percentage, letter grade or performance band.
  totalRating Int

  // The denominator that TOTAL RATING was signed against (item count x
  // MAX_SCORE). Stored and frozen, because it is no longer always 95: a later
  // template version with more or fewer items changes it for new sheets only.
  maxTotalRating Int

  // The form's header fields. `trainingEmployedAt`, `evaluatorName` and
  // `evaluatorPosition` are snapshots taken when the evaluation is written, so
  // renaming or deleting a supervisor later cannot rewrite a signed record.
  trainingStartedAt  DateTime?
  trainingEndedAt    DateTime?
  trainingEmployedAt String?
  evaluatorName      String?
  evaluatorPosition  String?

  comments        String?
  recommendations String?

  trainingAssignmentId String?
  trainingAssignment   TrainingAssignment? @relation(fields: [trainingAssignmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainingAssignmentId])
}

/// One version of the school's evaluation sheet.
///
/// At most one PUBLISHED and at most one DRAFT exist at any time; everything
/// else is ARCHIVED. A PUBLISHED or ARCHIVED template, and its sections and
/// items, are immutable — edits happen on the draft and take effect when it is
/// published, which archives the outgoing version. `status` stays a plain
/// String (DRAFT / PUBLISHED / ARCHIVED) rather than an enum, the same call as
/// Document.status.
model EvaluationTemplate {
  id          String    @id @default(cuid())
  version     Int       @unique
  status      String    @default("DRAFT")
  /// The sheet title as printed, e.g. ON-THE-JOB TRAINING PERFORMANCE EVALUATION SHEET.
  title       String
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  sections    EvaluationTemplateSection[]
  evaluations Evaluation[]
}

/// A numbered section of the sheet. The printed numeral (I, II, III ...) is
/// derived from `order` at read time, never stored, so reordering cannot
/// desync it from what is printed.
model EvaluationTemplateSection {
  id         String             @id @default(cuid())
  templateId String
  template   EvaluationTemplate @relation(fields: [templateId], references: [id])
  key        String
  label      String
  order      Int

  items EvaluationTemplateItem[]

  @@unique([templateId, key])
}

/// One scored row of the sheet. The printed letter (A, B, C ...) is derived
/// from `order` at read time, and the section's maxPoints is its item count x
/// MAX_SCORE — neither is stored.
model EvaluationTemplateItem {
  id        String                    @id @default(cuid())
  sectionId String
  section   EvaluationTemplateSection @relation(fields: [sectionId], references: [id])
  key       String
  label     String
  order     Int

  @@unique([sectionId, key])
}

/// One item's score on one evaluation.
///
/// `itemKey` is a plain string, not a foreign key to EvaluationTemplateItem:
/// the score is frozen against the template version the sheet was signed on,
/// and joining it to a live row would reintroduce exactly the coupling the
/// versioning removes.
model EvaluationScore {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  itemKey      String
  score        Int

  @@unique([evaluationId, itemKey])
}

model Conversation {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  name      String?
  createdBy String
  createdAt DateTime @default(now())

  /// Set only on a placement's group thread (`isGroup: true`): the one
  /// conversation in which the student, the establishment's supervisors and the
  /// coordinators all take part. Unique, so a placement can never have two.
  /// NULL on every 1:1 conversation, and Postgres does not treat NULLs as
  /// equal, so those are unaffected. The thread's display name is derived from
  /// the assignment at read time, not stored in `name`, so a rename shows up.
  trainingAssignmentId String?             @unique
  trainingAssignment   TrainingAssignment? @relation(fields: [trainingAssignmentId], references: [id])

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  createdAt      DateTime     @default(now())
}

/// A supervisor's concern about a trainee's conduct or performance, raised to
/// the coordinator and recorded against the placement.
///
/// Deliberately NOT a Message: it is a record with a status and a response,
/// kept permanently, and the 30-day message retention sweep never touches it.
/// The student has no route that reads this table.
model Concern {
  id                   String             @id @default(cuid())
  trainingAssignmentId String
  trainingAssignment   TrainingAssignment @relation(fields: [trainingAssignmentId], references: [id])
  /// Denormalised from the assignment, as on JournalEntry and WeeklyTask.
  studentId            String
  student              Student            @relation(fields: [studentId], references: [id])

  /// Nullable so the concern outlives the supervisor's account (it is nulled,
  /// never deleted — see cascade-delete.ts). `raisedByName` is the snapshot
  /// taken when it was raised, so the record still says who that was.
  raisedById   String?
  raisedBy     Supervisor? @relation(fields: [raisedById], references: [id])
  raisedByName String

  category    ConcernCategory
  description String
  status      ConcernStatus   @default(OPEN)

  coordinatorResponse String?
  respondedById       String?
  respondedBy         Coordinator? @relation(fields: [respondedById], references: [id])
  /// Moves only when the status or the response actually changes, so it is
  /// also the version marker of the CONCERN_RESPONDED notification.
  respondedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainingAssignmentId])
  @@index([status, createdAt])
}

/// A coordinator's announcement to students, supervisors or both, optionally
/// limited to one block and/or one program. Kept until a coordinator deletes
/// it; never touched by the message retention sweep.
model Announcement {
  id       String               @id @default(cuid())
  title    String
  body     String
  audience AnnouncementAudience

  /// Both optional and independent: NULL means "not limited by this".
  /// `onDelete: Restrict` — a restriction, not a cascade, like
  /// Evaluation.template: a block or course with an announcement on it cannot
  /// be deleted (CourseService answers 409 first), because the default SET
  /// NULL would silently widen who the announcement reaches.
  blockId  String?
  block    Block?  @relation(fields: [blockId], references: [id], onDelete: Restrict)
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  postedById String
  postedBy   Coordinator @relation(fields: [postedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reads AnnouncementRead[]

  @@index([audience, createdAt])
}

/// One user having read one announcement — what the unread marker is computed
/// from. No `onDelete: Cascade` (CLAUDE.md §6): rows are removed explicitly
/// when the announcement or the user is deleted.
model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

/// In-app notifications only (thesis Obj 9) — no email infrastructure exists,
/// same reasoning as the rest of the app's account-recovery story.
///
/// `onDelete: Cascade` here is a deliberate, narrow exception to CLAUDE.md §6
/// ("no onDelete: Cascade anywhere, deletion is spelled out explicitly in
/// cascade-delete.ts"). That rule exists because a person-delete has business
/// consequences worth spelling out (export files first, null an approver
/// rather than losing history, etc.). A notification has none of that — it is
/// disposable, derived, read-only-to-the-user data, so letting Postgres drop
/// it alongside its owner is strictly simpler and cannot lose anything that
/// matters. `deleteStudentCascade`/`deleteSupervisorCascade` do not need to
/// touch this table because of it.
///
/// `@@unique([userId, dedupeKey])` is what makes `notify()`'s
/// `createMany({ skipDuplicates: true })` idempotent for a re-run of the same
/// *event* (re-triggering the overdue sweep, a double-clicked action) without
/// swallowing a genuinely new one for the same record (a second decline after
/// a resubmission, a re-alert once a corrected entry goes overdue again).
/// `dedupeKey` — not `[type, entityId]` — is what encodes that distinction:
/// see `NotificationService.notify`'s own comment for the convention. NULL
/// when a call site sets none, and Postgres treats NULLs as distinct from
/// each other, so an un-deduped notification type is simply never coalesced.
model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  body   String
  // Client-side route the notification navigates to on click, e.g.
  // "/student/attendance". Absolute app path, not a full URL — this system has
  // one client origin.
  link   String?

  // What this notification is about — plain reference fields, read by the
  // client/future call sites, but no longer part of the dedupe key
  // themselves (see `dedupeKey`). Both optional: some notification types
  // (none yet) may have no single backing record.
  entityType String?
  entityId   String?

  // Idempotency key, distinct from entityType/entityId: encodes not just
  // *which* record but *which version/cycle* of it this notification is
  // about, so re-running the same trigger is a no-op while a new cycle for
  // the same record still gets through. Optional — a call site that never
  // needs deduping (none yet) simply omits it.
  dedupeKey String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}
